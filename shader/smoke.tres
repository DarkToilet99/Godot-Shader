code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 TextureSpin;
uniform sampler2D tex_vtx_14 : source_color;
uniform float TexturePower;
uniform float SmokeSize;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:16
	float n_out16p0 = TIME;


// Vector2Parameter:18
	vec2 n_out18p0 = TextureSpin;


// VectorOp:17
	vec2 n_out17p0 = vec2(n_out16p0) * n_out18p0;


// UVFunc:15
	vec2 n_in15p1 = vec2(1.00000, 1.00000);
	vec2 n_out15p0 = n_out17p0 * n_in15p1 + UV;


// Texture2D:14
	vec4 n_out14p0 = texture(tex_vtx_14, n_out15p0);


// Input:6
	vec3 n_out6p0 = NORMAL;


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out14p0.xyz) * n_out6p0;


// FloatParameter:13
	float n_out13p0 = TexturePower;


// VectorOp:4
	vec2 n_out4p0 = vec2(n_out7p0.xy) * vec2(n_out13p0);


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + vec3(n_out4p0, 0.0);


// FloatParameter:11
	float n_out11p0 = SmokeSize;


// VectorCompose:12
	vec3 n_out12p0 = vec3(n_out11p0, n_out11p0, n_out11p0);


// VectorOp:10
	vec3 n_out10p0 = n_out3p0 * n_out12p0;


// Output:0
	VERTEX = n_out10p0;


}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p4 = n_out2p0.a;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out2p4;


}
